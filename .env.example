# Kopioi nimelle .env ja muokkaa tarvittaessa (docker compose lukee tämän automaattisesti).

APP_PORT=8080
APP_DEBUG=false

DB_NAME=helpdesk
DB_USER=helpdesk
DB_PASS=helpdesk
DB_ROOT_PASS=rootsecret

# Tekoäly
OLLAMA_MODEL=gemma4:e2b
# Oletus: Docker-kontissa pyörivä Ollama. Koneella jo pyörivä Ollama:
# OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434
OLLAMA_TIMEOUT=300
OLLAMA_THINK=false

# Diagnoosi: tarkentavia kysymyskierroksia vähintään / enintään ennen päätöstä
CHAT_MIN_QUESTION_ROUNDS=1
CHAT_MAX_QUESTION_ROUNDS=4
